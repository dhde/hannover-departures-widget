    <string name="main_help_legal_title">Informacja prawna</string>
    <string name="main_help_legal_text">To nieoficjalna aplikacja. Nie jest powiązana z ÜSTRA Hannoversche Verkehrsbetriebe AG ani z GVH. Wszystkie dane pochodzą z publicznych interfejsów. Korzystasz na własne ryzyko.</string>
