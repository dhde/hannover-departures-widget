    <string name="main_help_messages_title">Alerts &amp; filters</string>
    <string name="main_help_messages_desc">Tap the golden \'i\' at the top left of the widget to read current alerts and disruptions. Alerts that last longer than a day (e.g. long-term roadworks or vehicle notices) can be hidden in the settings.</string>
    <string name="main_help_quick_title">Favourite shortcuts</string>
    <string name="main_help_quick_desc">Use the shortcut buttons at the bottom of the widget or tap the stop name at the top to switch between stops.</string>
    <string name="main_help_platforms_title">Platforms &amp; filters</string>
    <string name="main_help_platforms_desc">Tap a platform (e.g. “#1”, “#17”) to show only departures from there. The colour shows the lines serving it. Everything leaving from the same platform goes in the same direction. Tap again to show all.</string>
    <string name="main_help_size_title">Size</string>
    <string name="main_help_size_desc">In the settings you can change the size of the filter and favourite buttons (\'COMPACT\', \'STANDARD\', \'LARGE\') if you prefer larger tap targets.</string>
    <string name="main_help_time_title">Time display</string>
    <string name="main_help_time_desc">Tap a departure time in the widget to switch between countdown (minutes) and exact time. (Tip: in the settings you can choose whether this switches offline or refreshes from the API.)</string>
    <string name="main_help_time_desc_short">Tap a departure time in the widget to switch between countdown (minutes) and exact time.</string>
    <string name="main_help_refresh_title">Refreshing</string>
    <string name="main_help_refresh_desc">To save battery and data, the widget doesn\'t load data in the background. To get current real-time data and delays from the API, tap the small refresh arrow at the top right.</string>
    <string name="main_help_refresh_desc_legacy">The widget refreshes itself about every 15 minutes. For instant real-time data, tap the small refresh arrow at the top right.</string>
    <string name="main_help_gps_title">GPS search</string>
    <string name="main_help_gps_desc">Tap the location icon to have the widget automatically show departures from the nearest stop. Your position is updated on every refresh, so the display follows you while you\'re on the move.</string>
